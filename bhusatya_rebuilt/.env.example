# ==============================================================================
# BhuSatya - Environment Configuration Reference
# ==============================================================================

# --- Application Core ---
APP_ENV="development"
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:8000"

# --- Backend Database ---
# For SQLite (default local file):
DATABASE_URL="sqlite:///./backend/bhusatya.db"
# For PostgreSQL / PostGIS in production:
# DATABASE_URL="postgresql://bhusatya_user:SecurePassword123@localhost:5432/bhusatya"

# --- Security & Authentication (Server-Side Secrets) ---
# Cryptographic secret key used for signing JWT tokens
SECRET_KEY="bhusatya-change-this-in-production-to-a-64-char-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# --- OTP and Landowner Consent Dispatch ---
# Options: "console" (for local testing/dev), "msg91", "firebase"
OTP_PROVIDER="console"
OTP_PROVIDER_API_KEY="YOUR_MSG91_OR_FIREBASE_API_KEY"

# Optional Email / SMS Credentials
SMS_SENDER_ID="BHUSAT"
EMAIL_PROVIDER_API_KEY="YOUR_SENDGRID_OR_POSTMARK_KEY"

# --- Private Storage Configuration ---
# Absolute or relative paths to protected file directories (never exposed publicly)
UPLOAD_DIR="./backend/storage/uploads"
REPORTS_DIR="./backend/storage/reports"

# --- Public Client Configuration (Vite Frontend) ---
VITE_API_BASE_URL="http://localhost:8000"
VITE_MAP_TILE_PROVIDER="openstreetmap"
